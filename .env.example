# Copy to .env and adjust for local (non-Docker) runs.
DATABASE_URL=postgresql+asyncpg://mri:mri@localhost:5432/mri
CORS_ORIGINS=["*"]

# Storage: "local" (default) writes to disk under STORAGE_DIR. Switch to "s3"
# for any S3-compatible object store (e.g. Cloudflare R2) and fill in the
# S3_* vars below -- see the Deployment section of README.md.
STORAGE_BACKEND=local
STORAGE_DIR=storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
